# Shared secret your website form or lead portal sends in the X-Lead-Secret header (or as ?key= in the URL).
# Make up a long random string. With this empty, every lead is rejected.
LEAD_WEBHOOK_SECRET=make-up-a-long-random-string

# How the lead text introduces the business (default "our team")
BUSINESS_NAME=Acme Realty

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional, default claude-sonnet-5. claude-haiku-4-5 (cheaper) and claude-opus-5 also work.
# Not claude-opus-5-5 or claude-fable-5-1: they refuse the forced tool call this workflow uses.
ANTHROPIC_MODEL=claude-sonnet-5

# monday.com (profile picture → Developers → My access tokens)
MONDAY_API_TOKEN=your-monday-api-token
# Optional, default 2026-07 (the current stable version)
MONDAY_API_VERSION=2026-07
# The number in the board URL: https://yourteam.monday.com/boards/1234567890
MONDAY_BOARD_ID=1234567890
# Optional: the group new leads go into. Empty means the board's top group.
MONDAY_GROUP_ID=
# Optional: only if your column IDs differ from the ones in docs/setup.md. JSON, any subset, for example:
# MONDAY_COLUMNS={"status": "status", "agent": "text_agent"}
MONDAY_COLUMNS=

# Twilio (console.twilio.com → Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Send from one number, or from a Messaging Service (needed for US A2P 10DLC). If both are set, the Messaging Service wins.
TWILIO_FROM_NUMBER=+15125550100
TWILIO_MESSAGING_SERVICE_SID=

# The agents, in round robin order. phone in E.164. slack is a Slack member ID for mentions (optional). away: true skips them.
AGENTS_JSON=[{"name": "Maya Chen", "phone": "+15125550101", "slack": "U0123MAYA", "email": "maya@example.com", "away": false}, {"name": "Leo Park", "phone": "+15125550102", "slack": "U0123LEO", "email": "leo@example.com", "away": false}]

# Slack incoming webhook for the broker escalation alert and the error workflow. Leave empty to skip Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Optional: the broker's Slack member ID, so the escalation alert mentions them
BROKER_SLACK_ID=U0123BROKER

# Same phone or email within this many hours is the same lead: a note on the existing item, no new routing (default 72, minimum 1)
DEDUPE_HOURS=72
# Minutes the agent has to change the status from New before the lead moves to the next agent (default 5, minimum 0.05)
ESCALATION_MINUTES=5
# Quiet hours in TIMEZONE (default 21:00-08:00). Set to off to turn them off. See the README for what they change.
QUIET_HOURS=21:00-08:00
# IANA time zone name (default America/New_York)
TIMEZONE=America/Chicago
# Country for phone numbers written without a country code (default US). Supported: US CA GB IE AU NZ PH SG IN ZA AE MX
DEFAULT_COUNTRY=US

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
